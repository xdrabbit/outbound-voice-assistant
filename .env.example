# Vapi — https://dashboard.vapi.ai
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# Public URL Vapi can reach (ngrok / cloudflare tunnel / deployed host)
PUBLIC_BASE_URL=https://your-tunnel.example.com
WEBHOOK_SECRET=change-me

# Optional human takeover number (E.164)
TRANSFER_NUMBER=

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./data/outbound.db
DRY_RUN=true

# Compliance defaults (US TCPA-oriented)
DEFAULT_TZ=America/Denver
CALL_WINDOW_START=09:00
CALL_WINDOW_END=20:00
MAX_ATTEMPTS=3
RETRY_HOURS=4
